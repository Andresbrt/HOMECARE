{
  "name": "homecare-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "postinstall": "node scripts/patch-expo-notifications.js",
    "start": "expo start",
    "build:apk": "npx -y eas-cli build --profile preview --platform android",
    "build:ios": "npx -y eas-cli build --profile preview --platform ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:security": "API_URL=http://localhost:8080 jest __tests__/security/ --runInBand --verbose --testTimeout=30000",
    "test:security:staging": "jest __tests__/security/ --runInBand --verbose --testTimeout=30000",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:test:ios:se": "detox test --configuration ios.se.debug",
    "e2e:test:ios:max": "detox test --configuration ios.max.debug",
    "e2e:customer": "detox test --configuration ios.sim.debug e2e/01_happy_path_customer.e2e.js",
    "e2e:provider": "detox test --configuration ios.sim.debug e2e/02_happy_path_provider.e2e.js",
    "e2e:concurrent": "detox test --configuration ios.sim.debug e2e/03_concurrent_acceptance.e2e.js",
    "e2e:payment": "detox test --configuration ios.sim.debug e2e/04_payment_error_recovery.e2e.js",
    "e2e:chat": "detox test --configuration ios.sim.debug e2e/05_chat_edge_cases.e2e.js",
    "e2e:geo": "detox test --configuration ios.sim.debug e2e/06_geolocation_background.e2e.js",
    "e2e:offline": "detox test --configuration ios.sim.debug e2e/07_offline_resilience.e2e.js",
    "e2e:compliance": "detox test --configuration ios.sim.debug e2e/08_app_store_compliance.e2e.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "_helpers.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|axios)"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^12.2.1",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.9.4",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/stack": "^7.8.5",
    "@sentry/react-native": "~7.11.0",
    "@stomp/stompjs": "^7.3.0",
    "@supabase/supabase-js": "^2.104.1",
    "axios": "^1.7.2",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-root-siblings": "^5.0.1",
    "react-native-root-toast": "^4.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.7.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.4",
    "debug": "^4.4.3",
    "expo-constants": "~57.0.17",
    "expo-doctor": "^1.18.12",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
