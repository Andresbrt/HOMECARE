# Backend QA environment example
# Copia este archivo a qa/env/backend.env y completa los valores.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=homecare_db
DATABASE_USERNAME=homecare_user
DATABASE_PASSWORD=homecare_pass

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

WOMPI_PUBLIC_KEY=pub_test_example
WOMPI_PRIVATE_KEY=prv_test_example
WOMPI_EVENT_SECRET=test_event_secret
PAYMENT_CALLBACK_URL=http://localhost:8080/callback
PAYMENT_WEBHOOK_URL=http://localhost:8080/webhook

GOOGLE_MAPS_API_KEY=google_maps_test_key
FIREBASE_SERVER_KEY=firebase_test_key
AWS_ACCESS_KEY=test_aws_access
AWS_SECRET_KEY=test_aws_secret
AWS_S3_BUCKET=test_bucket
