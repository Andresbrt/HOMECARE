# Mobile QA environment example
# Copia este archivo a qa/env/mobile.env y completa los valores.

API_BASE_URL=http://localhost:8080/api/v1
SUPABASE_URL=https://your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# Cuentas de prueba
TEST_CUSTOMER_EMAIL=usuario@test.com
TEST_CUSTOMER_PASSWORD=Test123!
TEST_PROFESSIONAL_EMAIL=profesional@test.com
TEST_PROFESSIONAL_PASSWORD=Test123!
